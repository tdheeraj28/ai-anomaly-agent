# Copy this file to secrets.toml and fill in your own settings.
# Do not commit secrets.toml or share your app password.
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = "587"
SMTP_USERNAME = "your-gmail-address@gmail.com"
SMTP_PASSWORD = "your-16-character-google-app-password"
ALERT_FROM = "your-gmail-address@gmail.com"
ALERT_TO = "recipient@example.com"
